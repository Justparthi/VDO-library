# ─── AWS / S3 ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

SOURCE_BUCKET=your-source-bucket
DEST_BUCKET=your-dest-bucket

# ─── CloudFront ─────────────────────────────────────────────────────────────
CF_KEY_PAIR_ID=your-cloudfront-key-pair-id
# Paste the full PEM (replace newlines with \n), or use a file path
CF_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Cookie lifetime in seconds (default 600 = 10 min)
COOKIE_TTL_SECONDS=600

# ─── Domains ────────────────────────────────────────────────────────────────
# Production example: APP_DOMAIN=myapp.com  CDN_DOMAIN=cdn.myapp.com  COOKIE_DOMAIN=.myapp.com
# Local dev example:  APP_DOMAIN=local.myapp.test  CDN_DOMAIN=cdn.myapp.test  COOKIE_DOMAIN=.myapp.test
APP_DOMAIN=local.myapp.test
CDN_DOMAIN=cdn.myapp.test
COOKIE_DOMAIN=.myapp.test

# ─── Local dev only (remove in production) ──────────────────────────────────
# Points the AWS SDK at the local SeaweedFS S3
S3_ENDPOINT=http://localhost:8333
# Path to the dev RSA private key (PEM) generated by dev/scripts/gen-keys.mjs
CF_PRIVATE_KEY_FILE=dev/keys/private.pem

# Ports
PORT=3001
FAKE_CDN_PORT=3002
SEAWEED_PORT=8333

# ─── App ────────────────────────────────────────────────────────────────────
# Simple shared secret for the example-app login stub
SESSION_SECRET=change-me-to-a-random-string
