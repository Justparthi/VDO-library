{
  "name": "secure-media",
  "private": true,
  "workspaces": [
    "packages/*",
    "dev/fake-cdn",
    "dev/example-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:infra": "docker compose -f dev/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f dev/docker-compose.yml down",
    "dev:infra:logs": "docker compose -f dev/docker-compose.yml logs -f",
    "dev:keys": "node dev/scripts/gen-keys.mjs",
    "dev:cdn": "npm run dev --workspace=dev/fake-cdn",
    "dev:app": "npm run dev --workspace=dev/example-app"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsup": "^8.0.2",
    "vitest": "^1.6.0",
    "@types/node": "^20.14.0"
  }
}
